# Flashback MCP server (Streamable HTTP). Install to /etc/systemd/system/ —
# see deploy/systemd/README.md for the full native-Linux setup.
[Unit]
Description=Flashback MCP server (Streamable HTTP)
After=flashback.service
Wants=flashback.service

[Service]
User=flashback
Group=flashback
WorkingDirectory=/opt/flashback
# No secrets needed — the MCP server forwards each client's Bearer upstream.
Environment=FLASHBACK_URL=http://127.0.0.1:8080
Environment=MCP_PORT=8082
Environment=RUST_LOG=flashback_mcp=info
# After the Environment= lines so the file can override them, and matching
# flashback.service, which has read this file all along. MCP_HOST is deliberately
# not set here: the binary binds loopback on its own, and widening it should take
# an edit somebody makes on purpose rather than a default nobody sees.
EnvironmentFile=-/opt/flashback/.env
ExecStart=/opt/flashback/bin/flashback-mcp
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
