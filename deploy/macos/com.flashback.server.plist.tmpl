<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.flashback.server</string>

	<!-- Runtime config lives in __FLASHBACK_HOME__/.env — the binary loads it
	     from its working directory, so the plist stays free of secrets. -->
	<key>ProgramArguments</key>
	<array>
		<string>__FLASHBACK_HOME__/bin/flashback</string>
		<string>serve</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__FLASHBACK_HOME__</string>
	<key>UserName</key>
	<string>__RUN_USER__</string>

	<!-- Start at boot with nobody logged in, restart on crash.
	     ThrottleInterval stops a crash loop from spinning the CPU. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>__FLASHBACK_HOME__/logs/server.log</string>
	<key>StandardErrorPath</key>
	<string>__FLASHBACK_HOME__/logs/server.log</string>
</dict>
</plist>
