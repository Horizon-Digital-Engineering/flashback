# Database
DATABASE_URL=postgres://flashback:flashback@localhost:5432/flashback

# Server
HOST=0.0.0.0
PORT=8080
RUST_LOG=flashback=info,tower_http=debug

# Run migrations automatically on server start (1/true/yes).
AUTO_MIGRATE=1

# Pin the fastembed model cache so the Docker build's prefetched ONNX is reused.
FLASHBACK_FASTEMBED_CACHE=/opt/flashback/fastembed-cache

# ---------------------------------------------------------------------------
# AI extraction provider
# ---------------------------------------------------------------------------
# Picks which AiProvider runs at ingest time to populate the structured
# Extraction stored alongside each memory.
#
#   heuristic — rule-based, in-process, no network. Default. No API key needed.
#   remote    — HTTP to any OpenAI-compatible / Anthropic / OpenRouter URL.
#               This is the 90% case: cloud Claude, a sidecar Ollama
#               container, a Mac mini or DGX Spark on your LAN — same code
#               path, just a different URL.
#   embedded  — LLM running INSIDE the Flashback binary via mistral.rs.
#               No HTTP, no sidecar. Use when Flashback IS the AI box's only
#               service or in air-gapped deploys. Phase 2b, not yet wired.
#
PROVIDER=heuristic

# What to do when the provider fails:
#   fail      — return an error from /memory/ingest. Default.
#   heuristic — silently fall back to the heuristic provider. Choose this if
#               you can't tolerate ingest errors during transient API outages.
PROVIDER_FALLBACK=fail

# Remote provider config (only used when PROVIDER=remote).
PROVIDER_REMOTE_PROVIDER=openrouter
PROVIDER_REMOTE_MODEL=anthropic/claude-haiku-4-5
# Generic API key; provider-specific aliases also accepted:
#   - OPENROUTER_API_KEY (when PROVIDER_REMOTE_PROVIDER=openrouter)
#   - ANTHROPIC_API_KEY  (when PROVIDER_REMOTE_PROVIDER=anthropic)
#   - OPENAI_API_KEY     (when PROVIDER_REMOTE_PROVIDER=openai)
PROVIDER_REMOTE_API_KEY=
# Override the API base URL — useful for self-hosted OpenAI-compatible
# gateways (vLLM, llama.cpp server, etc).
# PROVIDER_REMOTE_API_BASE=https://openrouter.ai/api/v1
PROVIDER_REMOTE_TIMEOUT_MS=5000
# Anthropic prompt-cache (~90% discount on system-prompt tokens). 1 = on.
PROVIDER_REMOTE_PROMPT_CACHE=1

# ---------------------------------------------------------------------------
# Per-role model tiering (optional) — see docs/MODEL-TIERING.md
# ---------------------------------------------------------------------------
# Flashback runs two LLM calls of very different shapes:
#   extract()       — write path, ~150-250 tok out, sub-2s budget. Small model.
#   distill_facts() — background worker, ~500-1000 tok out, minutes OK. Big model.
#
# These optional overrides let each role pick its own model + token cap +
# timeout. Each falls back to PROVIDER_REMOTE_MODEL / PROVIDER_REMOTE_TIMEOUT_MS
# if unset, so a single-model deploy works unchanged.
#
# Worked example for a local Ollama sidecar with 16 GB VRAM:
#   PROVIDER_REMOTE_EXTRACT_MODEL=qwen2.5:3b-instruct
#   PROVIDER_REMOTE_DISTILL_MODEL=qwen2.5:14b-instruct-q5_K_M
#   PROVIDER_REMOTE_EXTRACT_MAX_TOKENS=256
#   PROVIDER_REMOTE_DISTILL_MAX_TOKENS=1024
#   PROVIDER_REMOTE_EXTRACT_TIMEOUT_MS=10000
#   PROVIDER_REMOTE_DISTILL_TIMEOUT_MS=120000
